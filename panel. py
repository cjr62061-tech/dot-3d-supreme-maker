def get_buyers_list(firebase_db):
    # Sirf khareedne walo ki list laayega
    buyers = []
    try:
        docs = firebase_db.collection("users").where("is_purchased", "==", True).stream()
        for doc in docs:
            data = doc.to_dict()
            buyers.append({
                "naam": data.get("name", "N/A"),
                "email": data.get("email", "N/A"),
                "number": data.get("phone", "N/A"),
                "date": data.get("purchase_date", "N/A")
            })
    except Exception as e:
        print(f"Error: {e}")
    return buyers

